{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 1 -X POST -H \"content-type: application/json\" --data-binary @- \"http://127.0.0.1:7777/events/claude?pid=$PPID\" >/dev/null 2>&1 || true",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 1 -X POST -H \"content-type: application/json\" --data-binary @- \"http://127.0.0.1:7777/events/claude?pid=$PPID\" >/dev/null 2>&1 || true",
            "timeout": 3
          }
        ]
      }
    ],
