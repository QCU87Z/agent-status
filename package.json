{
  "name": "agent-status",
  "version": "0.1.1",
  "private": true,
  "description": "One local page showing every Claude Code and OpenCode session and whether it needs you",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/build-release.mjs",
    "install-hooks": "node scripts/install-claude-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
